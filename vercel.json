{
  "version": 2,
  "buildCommand": "npx expo export --platform web && exit 0",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/scan.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
